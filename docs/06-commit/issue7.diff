+    gap: 14px;
+  }
+  .sm-act-grid > * + * {
+    margin-top: 0;
+  }
+}
+
+
+/* ---------- 24. 320px 护栏（Issue #7 AC4：窄屏不横向溢出） ---------- */
+/*
+ * 320px 下最容易溢出的三处：顶栏两侧留白 + 「发起」按钮、卡片底部
+ * 「时间 / 名额 / 报名」挤在一行、以及筛选芯片整排铺开。
+ * 这里只收留白、允许换行，不改任何字号与颜色，视觉上与 390px 保持一致。
+ */
+@media (max-width: 360px) {
+  .sm-main {
+    padding-left: 12px;
+    padding-right: 12px;
+  }
+  .sm-appbar__inner {
