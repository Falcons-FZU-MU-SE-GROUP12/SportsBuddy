+}
+.sm-sheet__panel {
+  background: #fff;
+  width: 100%;
+  max-width: 520px;
+  border-radius: 20px 20px 0 0;
+  padding: 18px 16px calc(18px + env(safe-area-inset-bottom));
+  max-height: 88vh;
+  overflow-y: auto;
+  box-shadow: var(--sh-3);
+}
+.sm-sheet__head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  margin-bottom: 12px;
+}
+.sm-sheet__title {
+  font-size: 16.5px;
+  font-weight: 680;
+}
+@media (min-width: 560px) {
+  .sm-sheet {
+    align-items: center;
+  }
+  .sm-sheet__panel {
+    border-radius: 20px;
+    max-width: 460px;
+  }
+}
+
+/* ---------- 21. 星评 ---------- */
+.sm-stars {
+  display: flex;
+  gap: 6px;
+}
+.sm-star {
+  border: 0;
+  background: none;
+  font-size: 26px;
+  line-height: 1;
+  cursor: pointer;
+  color: #d9dde7;
+  padding: 0;
+}
+.sm-star[aria-checked="true"] {
