+<title>Issue #7 活动列表 · 320px 静态快照</title>
+<style>
+/* ==========================================================================
+   动搭 SportMate · 设计系统
+   --------------------------------------------------------------------------
+   这一份 CSS 同时服务两个交付物：
+     1) frontend/   真实可用前端（连后端或离线 mock）
+     2) prototype/  界面原型（复用同一套样式，保证原型与实现一致）
+   因此这里只放"与数据无关"的视觉规则，不放任何业务逻辑。
+   ========================================================================== */
+
+/* ---------- 1. 设计令牌 ---------- */
+:root {
+  /* 主色：活力橙（运动感），辅助色：青绿（信用分/成功） */
+  --brand: #ff6a3d;
+  --brand-600: #f2542d;
+  --brand-100: #fff1eb;
+  --accent: #12b5a5;
+  --accent-100: #e6f8f6;
+
+  /* 中性色阶 */
+  --ink: #16181d;
+  --ink-2: #4a5060;
+  --ink-3: #7b8398;
+  --line: #edeff4;
+  --line-2: #e0e4ec;
+  --surface: #ffffff;
+  --surface-2: #f6f7fb;
+  --bg: #f2f4f9;
+
+  /* 语义色 */
+  --ok: #10a37f;
+  --ok-bg: #e8f8f2;
+  --warn: #c07800;
+  --warn-bg: #fff6e0;
+  --danger: #d92d4b;
+  --danger-bg: #fdecef;
+  --info: #2f6fd0;
+  --info-bg: #eaf2fe;
+
+  /* 形状与阴影 */
+  --r-sm: 8px;
+  --r: 12px;
+  --r-lg: 18px;
+  --r-pill: 999px;
+  --sh-1: 0 1px 2px rgba(22, 24, 29, 0.05);
+  --sh-2: 0 4px 14px rgba(22, 24, 29, 0.07);
+  --sh-3: 0 12px 34px rgba(22, 24, 29, 0.12);
+
+  --font: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB",
+    "Microsoft YaHei", "Source Han Sans SC", "Noto Sans CJK SC", sans-serif;
+  --font-num: "SF Mono", "JetBrains Mono", ui-monospace, Consolas, monospace;
+}
+
+/* ---------- 2. 归零 ---------- */
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+html,
+body {
+  margin: 0;
+  padding: 0;
+}
+body {
+  font-family: var(--font);
+  color: var(--ink);
+  background: var(--bg);
+  font-size: 15px;
+  line-height: 1.55;
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+}
+h1,
+h2,
+h3,
+h4,
+p,
+ul,
+ol,
+figure {
+  margin: 0;
+}
+ul,
+ol {
+  padding: 0;
+  list-style: none;
+}
+button,
+input,
+select,
+textarea {
+  font: inherit;
+  color: inherit;
+}
+a {
+  color: var(--brand-600);
+  text-decoration: none;
+}
+a:hover {
+  text-decoration: underline;
+}
+img,
+svg {
+  display: block;
+  max-width: 100%;
+}
+
+/* ---------- 3. 布局骨架 ---------- */
+.sm-shell {
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+  background: var(--bg);
+}
+.sm-main {
+  flex: 1;
+  width: 100%;
+  max-width: 520px;
+  margin: 0 auto;
+  padding: 16px 16px 96px;
+}
+.sm-main--wide {
+  max-width: 900px;
+}
+.sm-stack > * + * {
+  margin-top: 14px;
+}
+.sm-row {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+.sm-row--wrap {
+  flex-wrap: wrap;
+}
+.sm-row--between {
+  justify-content: space-between;
+}
+.sm-spacer {
+  flex: 1;
+}
+.sm-hide {
+  display: none !important;
+}
+
+/* ---------- 4. 顶部栏 ---------- */
+.sm-appbar {
+  position: sticky;
+  top: 0;
+  z-index: 20;
+  background: rgba(255, 255, 255, 0.86);
+  backdrop-filter: saturate(180%) blur(12px);
+  border-bottom: 1px solid var(--line);
+}
+.sm-appbar__inner {
+  max-width: 520px;
+  margin: 0 auto;
+  padding: 12px 16px;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+.sm-appbar__title {
+  font-size: 17px;
+  font-weight: 650;
+  letter-spacing: -0.01em;
+}
+.sm-appbar__sub {
+  font-size: 12px;
+  color: var(--ink-3);
+}
+.sm-brand {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+}
+.sm-brand__mark {
+  width: 30px;
+  height: 30px;
+  border-radius: 9px;
+  background: linear-gradient(135deg, var(--brand) 0%, #ff9166 100%);
+  color: #fff;
+  display: grid;
+  place-items: center;
+  font-size: 16px;
+  box-shadow: 0 3px 10px rgba(255, 106, 61, 0.32);
+}
+.sm-brand__name {
+  font-size: 16px;
+  font-weight: 700;
+  letter-spacing: -0.02em;
+}
+.sm-backbtn {
+  width: 34px;
+  height: 34px;
+  border-radius: 10px;
+  border: 1px solid var(--line-2);
+  background: #fff;
+  cursor: pointer;
+  display: grid;
+  place-items: center;
+  font-size: 16px;
+  color: var(--ink-2);
+  flex: none;
+}
+.sm-backbtn:hover {
+  background: var(--surface-2);
+}
+
+/* ---------- 5. 卡片 ---------- */
+.sm-card {
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-radius: var(--r-lg);
+  box-shadow: var(--sh-1);
+  padding: 16px;
+}
+.sm-card--flat {
+  box-shadow: none;
+}
+.sm-card--brand {
+  background: linear-gradient(140deg, #fff 0%, var(--brand-100) 100%);
+  border-color: #ffd9c9;
+}
+.sm-card__title {
+  font-size: 15px;
+  font-weight: 650;
+  margin-bottom: 10px;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.sm-card__hint {
+  font-size: 12.5px;
+  color: var(--ink-3);
+  line-height: 1.6;
+}
+.sm-divider {
+  height: 1px;
+  background: var(--line);
+  margin: 12px 0;
+  border: 0;
+}
+
+/* ---------- 6. 按钮 ---------- */
+.sm-btn {
+  --btn-bg: #fff;
+  --btn-fg: var(--ink);
+  --btn-bd: var(--line-2);
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  padding: 10px 16px;
+  min-height: 42px;
+  border-radius: var(--r);
+  border: 1px solid var(--btn-bd);
+  background: var(--btn-bg);
+  color: var(--btn-fg);
+  font-size: 14.5px;
+  font-weight: 600;
+  cursor: pointer;
+  transition: transform 0.06s ease, filter 0.15s ease, background 0.15s ease;
+  white-space: nowrap;
+  user-select: none;
+}
+.sm-btn:hover:not(:disabled) {
+  filter: brightness(0.97);
+}
+.sm-btn:active:not(:disabled) {
+  transform: translateY(1px);
+}
+.sm-btn:disabled {
+  opacity: 0.45;
+  cursor: not-allowed;
+}
+.sm-btn--primary {
+  --btn-bg: var(--brand);
+  --btn-fg: #fff;
+  --btn-bd: var(--brand);
+  box-shadow: 0 4px 12px rgba(255, 106, 61, 0.28);
+}
+.sm-btn--accent {
+  --btn-bg: var(--accent);
+  --btn-fg: #fff;
+  --btn-bd: var(--accent);
+}
+.sm-btn--ghost {
+  --btn-bg: var(--surface-2);
+  --btn-bd: transparent;
+  color: var(--ink-2);
+}
+.sm-btn--danger {
+  --btn-fg: var(--danger);
+  --btn-bd: #f6c9d2;
+  --btn-bg: #fff;
+}
+.sm-btn--block {
+  width: 100%;
+}
+.sm-btn--sm {
+  min-height: 34px;
+  padding: 6px 12px;
+  font-size: 13px;
+  border-radius: 10px;
+}
+.sm-btn--lg {
+  min-height: 50px;
+  font-size: 16px;
+  border-radius: 14px;
+}
+
+/* ---------- 7. 表单 ---------- */
+.sm-field {
+  display: block;
+}
+.sm-field + .sm-field {
+  margin-top: 12px;
+}
+.sm-label {
+  display: block;
+  font-size: 12.5px;
+  font-weight: 600;
+  color: var(--ink-2);
+  margin-bottom: 6px;
+}
+.sm-label__opt {
+  font-weight: 500;
+  color: var(--ink-3);
+}
+.sm-input,
+.sm-select,
+.sm-textarea {
+  width: 100%;
+  padding: 11px 13px;
+  border: 1px solid var(--line-2);
+  border-radius: var(--r);
+  background: #fff;
+  outline: none;
+  transition: border-color 0.15s ease, box-shadow 0.15s ease;
+}
+.sm-textarea {
+  min-height: 76px;
+  resize: vertical;
+}
+.sm-input:focus,
+.sm-select:focus,
+.sm-textarea:focus {
+  border-color: var(--brand);
+  box-shadow: 0 0 0 3px rgba(255, 106, 61, 0.14);
+}
+.sm-input::placeholder,
+.sm-textarea::placeholder {
+  color: #a9b0c0;
+}
+.sm-input[type="number"] {
+  font-family: var(--font-num);
+}
+.sm-grid2 {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 12px;
+}
+@media (max-width: 420px) {
+  .sm-grid2 {
+    grid-template-columns: 1fr;
+  }
+}
+.sm-check {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 13.5px;
+  cursor: pointer;
+}
+.sm-check input {
+  width: 16px;
+  height: 16px;
+  accent-color: var(--brand);
+  flex: none;
+}
+.sm-switch {
+  display: inline-flex;
+  background: var(--surface-2);
+  border-radius: var(--r-pill);
+  padding: 3px;
+  gap: 2px;
+}
+.sm-switch button {
+  border: 0;
+  background: transparent;
+  padding: 7px 16px;
+  border-radius: var(--r-pill);
+  font-size: 13.5px;
+  font-weight: 600;
+  color: var(--ink-3);
+  cursor: pointer;
+}
+.sm-switch button[aria-pressed="true"] {
+  background: #fff;
+  color: var(--ink);
+  box-shadow: var(--sh-1);
+}
+
+/* ---------- 8. 标签 / 徽标 ---------- */
+.sm-tag {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 2px 8px;
+  border-radius: 6px;
+  background: var(--surface-2);
+  color: var(--ink-2);
+  font-size: 11.5px;
+  font-weight: 600;
+  line-height: 1.7;
+  white-space: nowrap;
+}
+.sm-tag--brand {
+  background: var(--brand-100);
+  color: var(--brand-600);
+}
+.sm-tag--ok {
+  background: var(--ok-bg);
+  color: var(--ok);
+}
+.sm-tag--warn {
+  background: var(--warn-bg);
+  color: var(--warn);
+}
+.sm-tag--danger {
+  background: var(--danger-bg);
+  color: var(--danger);
+}
+.sm-tag--info {
+  background: var(--info-bg);
+  color: var(--info);
+}
+.sm-tag--ghost {
+  background: transparent;
+  border: 1px solid var(--line-2);
+  color: var(--ink-3);
+}
+.sm-dot {
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: currentColor;
+  flex: none;
+}
+
+/* ---------- 9. 活动卡片 ---------- */
+.sm-act {
+  position: relative;
+  display: block;
+  width: 100%;
+  text-align: left;
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-radius: var(--r-lg);
+  padding: 14px;
+  box-shadow: var(--sh-1);
+  cursor: pointer;
+  transition: box-shadow 0.15s ease, transform 0.1s ease, border-color 0.15s ease;
+}
+.sm-act:hover {
+  box-shadow: var(--sh-2);
+  border-color: #ffd9c9;
+}
+.sm-act:active {
+  transform: scale(0.995);
+}
+.sm-act__head {
+  display: flex;
+  gap: 10px;
+  align-items: flex-start;
+}
+.sm-act__sport {
+  width: 42px;
+  height: 42px;
+  border-radius: 12px;
+  background: var(--brand-100);
+  display: grid;
+  place-items: center;
+  font-size: 21px;
+  flex: none;
+}
+.sm-act__title {
+  font-size: 15.5px;
+  font-weight: 660;
+  letter-spacing: -0.01em;
+  line-height: 1.35;
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+  overflow-wrap: anywhere;
+}
+.sm-act__meta {
+  font-size: 12.5px;
+  color: var(--ink-3);
+  margin-top: 3px;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 4px 8px;
+}
+.sm-act__meta b {
+  color: var(--ink-2);
+  font-weight: 600;
+}
+.sm-act__tags {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin-top: 10px;
+}
+.sm-act__foot {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  margin-top: 12px;
+  padding-top: 11px;
+  border-top: 1px dashed var(--line-2);
+}
+.sm-act__org {
+  font-size: 12px;
+  color: var(--ink-3);
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  min-width: 0;
+}
+.sm-act__org b {
+  color: var(--ink-2);
+  font-weight: 600;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.sm-avatar {
+  width: 22px;
+  height: 22px;
+  border-radius: 50%;
+  background: var(--surface-2);
+  border: 1px solid var(--line-2);
+  display: grid;
+  place-items: center;
+  font-size: 11px;
+  font-weight: 700;
+  color: var(--ink-3);
+  flex: none;
+}
+.sm-avatar--lg {
+  width: 46px;
+  height: 46px;
+  font-size: 18px;
+}
+
+/* 座位进度条 */
+.sm-seats {
+  margin-top: 11px;
+}
+.sm-seats__bar {
+  height: 6px;
+  border-radius: 99px;
+  background: var(--surface-2);
+  overflow: hidden;
+}
+.sm-seats__fill {
+  height: 100%;
+  border-radius: 99px;
+  background: linear-gradient(90deg, var(--accent) 0%, #4fd6c6 100%);
+}
+.sm-seats__fill--full {
+  background: linear-gradient(90deg, #f0a500 0%, #ffc94d 100%);
+}
+.sm-seats__txt {
+  display: flex;
+  justify-content: space-between;
+  font-size: 11.5px;
+  color: var(--ink-3);
+  margin-top: 5px;
+}
+.sm-seats__txt b {
+  color: var(--ink-2);
+  font-family: var(--font-num);
+}
+
+/* ---------- 10. 匹配理由 ---------- */
+.sm-reason {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin-top: 10px;
+}
+.sm-score {
+  margin-left: auto;
+  font-size: 11.5px;
+  font-weight: 700;
+  color: var(--brand-600);
+  background: var(--brand-100);
+  padding: 2px 9px;
+  border-radius: var(--r-pill);
+  font-family: var(--font-num);
+}
+
+/* ---------- 11. 一句话找局 ---------- */
+.sm-nlp {
+  background: linear-gradient(140deg, #2b2f3a 0%, #454b5c 100%);
+  border-radius: var(--r-lg);
+  padding: 16px;
+  color: #fff;
+  box-shadow: var(--sh-2);
+}
+.sm-nlp__label {
+  font-size: 12.5px;
+  color: rgba(255, 255, 255, 0.66);
+  margin-bottom: 8px;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+.sm-nlp__row {
+  display: flex;
+  gap: 8px;
+}
+.sm-nlp__input {
+  flex: 1;
+  border: 0;
+  border-radius: var(--r);
+  padding: 12px 13px;
+  background: rgba(255, 255, 255, 0.12);
+  color: #fff;
+  outline: none;
+  min-width: 0;
+}
+.sm-nlp__input::placeholder {
+  color: rgba(255, 255, 255, 0.5);
+}
+.sm-nlp .sm-btn--primary {
+  box-shadow: none;
+}
+.sm-nlp__chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin-top: 10px;
+}
+.sm-nlp__chip {
+  border: 1px solid rgba(255, 255, 255, 0.22);
+  background: rgba(255, 255, 255, 0.06);
+  color: rgba(255, 255, 255, 0.88);
+  border-radius: var(--r-pill);
+  padding: 4px 11px;
+  font-size: 12px;
+  cursor: pointer;
+}
+.sm-nlp__chip:hover {
+  background: rgba(255, 255, 255, 0.14);
+}
+
+/* ---------- 12. 筛选条 ---------- */
+.sm-filters {
+  display: flex;
+  gap: 8px;
+  overflow-x: auto;
+  padding: 2px 0 4px;
+  margin: 0 -16px;
+  padding-left: 16px;
+  padding-right: 16px;
+  scrollbar-width: none;
+}
+.sm-filters::-webkit-scrollbar {
+  display: none;
+}
+.sm-chip {
+  border: 1px solid var(--line-2);
+  background: #fff;
+  border-radius: var(--r-pill);
+  padding: 7px 14px;
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--ink-2);
+  cursor: pointer;
+  white-space: nowrap;
+  flex: none;
+}
+.sm-chip[aria-pressed="true"] {
+  background: var(--ink);
+  border-color: var(--ink);
+  color: #fff;
+}
+.sm-chip--mini {
+  padding: 5px 11px;
+  font-size: 12.5px;
+}
+
+/* ---------- 13. 信用分 ---------- */
+.sm-credit {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+}
+.sm-credit__ring {
+  flex: none;
+  width: 78px;
+  height: 78px;
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  position: relative;
+}
+.sm-credit__num {
+  font-family: var(--font-num);
+  font-size: 25px;
+  font-weight: 700;
+  line-height: 1;
+}
+.sm-credit__unit {
+  font-size: 10.5px;
+  color: var(--ink-3);
+  display: block;
+  text-align: center;
+  margin-top: 3px;
+}
+.sm-credit__stats {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 8px;
+  flex: 1;
+}
+.sm-stat {
+  text-align: center;
+  background: var(--surface-2);
+  border-radius: var(--r);
+  padding: 8px 4px;
+}
+.sm-stat__num {
+  font-family: var(--font-num);
+  font-size: 16px;
+  font-weight: 700;
+}
+.sm-stat__label {
+  font-size: 11px;
+  color: var(--ink-3);
+  margin-top: 1px;
+}
+
+/* ---------- 14. 时间线 / 列表行 ---------- */
+.sm-list {
+  border-radius: var(--r-lg);
+  background: var(--surface);
+  border: 1px solid var(--line);
+  overflow: hidden;
+}
+.sm-list__item {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 13px 15px;
+  cursor: pointer;
+  background: none;
+  border: 0;
+  width: 100%;
+  text-align: left;
+}
+.sm-list__item + .sm-list__item {
+  border-top: 1px solid var(--line);
+}
+.sm-list__item:hover {
+  background: var(--surface-2);
+}
+.sm-list__icon {
+  width: 34px;
+  height: 34px;
+  border-radius: 10px;
+  background: var(--surface-2);
+  display: grid;
+  place-items: center;
+  font-size: 17px;
+  flex: none;
+}
+.sm-list__body {
+  flex: 1;
+  min-width: 0;
+}
+.sm-list__title {
+  font-size: 14.5px;
+  font-weight: 600;
+}
+.sm-list__desc {
+  font-size: 12px;
+  color: var(--ink-3);
+  margin-top: 1px;
+}
+.sm-list__chev {
+  color: #c2c8d6;
+  font-size: 17px;
+  flex: none;
+}
+
+/* ---------- 15. 详情页 ---------- */
+.sm-hero {
+  background: var(--surface);
+  border-bottom: 1px solid var(--line);
+  padding: 18px 16px 20px;
+}
+.sm-hero__inner {
+  max-width: 520px;
+  margin: 0 auto;
+}
+.sm-hero__title {
+  font-size: 21px;
+  font-weight: 700;
+  letter-spacing: -0.02em;
+  line-height: 1.3;
+}
+.sm-facts {
+  display: grid;
+  gap: 10px;
+}
+.sm-fact {
+  display: flex;
+  gap: 10px;
+  align-items: flex-start;
+  font-size: 13.5px;
+}
+.sm-fact__k {
+  width: 68px;
+  flex: none;
+  color: var(--ink-3);
+}
+.sm-fact__v {
+  flex: 1;
+  color: var(--ink);
+  font-weight: 500;
+}
+.sm-code {
+  display: flex;
+  gap: 8px;
+  margin: 6px 0 2px;
+}
+.sm-code__cell {
+  flex: 1;
+  background: var(--ink);
+  color: #fff;
+  border-radius: var(--r);
+  font-family: var(--font-num);
+  font-size: 26px;
+  font-weight: 700;
+  text-align: center;
+  padding: 10px 0;
+  letter-spacing: 2px;
+}
+.sm-member {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 10px 0;
+}
+.sm-member + .sm-member {
+  border-top: 1px solid var(--line);
+}
+.sm-member__body {
+  flex: 1;
+  min-width: 0;
+}
+.sm-member__name {
+  font-size: 14px;
+  font-weight: 620;
+}
+.sm-member__sub {
+  font-size: 11.5px;
+  color: var(--ink-3);
+}
+
+/* ---------- 16. 反馈条 ---------- */
+.sm-alert {
+  display: flex;
+  gap: 9px;
+  align-items: flex-start;
+  padding: 11px 13px;
+  border-radius: var(--r);
+  font-size: 13px;
+  line-height: 1.5;
+}
+.sm-alert--error {
+  background: var(--danger-bg);
+  color: #8f1730;
+}
+.sm-alert--ok {
+  background: var(--ok-bg);
+  color: #0a6b52;
+}
+.sm-alert--info {
+  background: var(--info-bg);
+  color: #1c4e97;
+}
+.sm-alert--warn {
+  background: var(--warn-bg);
+  color: #8a5800;
+}
+.sm-alert__icon {
+  flex: none;
+  font-size: 14px;
+  line-height: 1.4;
+}
+
+/* ---------- 17. 空态 / 加载 ---------- */
+.sm-empty {
+  text-align: center;
+  padding: 40px 20px;
+  color: var(--ink-3);
+}
+.sm-empty__icon {
+  font-size: 34px;
+  margin-bottom: 8px;
+  opacity: 0.75;
+}
+.sm-empty__title {
+  font-size: 14.5px;
+  font-weight: 600;
+  color: var(--ink-2);
+}
+.sm-empty__desc {
+  font-size: 12.5px;
+  margin-top: 4px;
+}
+.sm-skel {
+  border-radius: var(--r);
+  background: linear-gradient(90deg, #eef0f5 25%, #f6f7fa 37%, #eef0f5 63%);
