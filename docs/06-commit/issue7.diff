+}
+.sm-bars {
+  display: grid;
+  gap: 6px;
+}
+.sm-bar {
+  display: grid;
+  grid-template-columns: 68px 1fr 34px;
+  align-items: center;
+  gap: 8px;
+  font-size: 12px;
+  color: var(--ink-3);
+}
+.sm-bar__track {
+  display: block;
+  height: 6px;
+  border-radius: 99px;
+  background: var(--surface-2);
+  overflow: hidden;
+}
+.sm-bar__fill {
+  display: block;
+  height: 100%;
+  border-radius: 99px;
+  background: #ffb020;
+}
+.sm-bar__num {
+  text-align: right;
+  font-family: var(--font-num);
+  color: var(--ink-2);
+}
+
+/* ---------- 22. 离线提示 ---------- */
+.sm-offline {
+  background: #2b2f3a;
+  color: #fff;
+  font-size: 12px;
+  text-align: center;
+  padding: 6px 12px;
+}
+.sm-offline b {
+  color: #ffd08a;
+}
+
+/* ---------- 23. 桌面端适配 ---------- */
+@media (min-width: 900px) {
+  .sm-main,
+  .sm-appbar__inner,
+  .sm-hero__inner {
+    max-width: 760px;
+  }
+  .sm-act-grid {
+    display: grid;
