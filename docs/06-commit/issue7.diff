+}
+
+/* ---------- 19. 认证页 ---------- */
+.sm-auth {
+  min-height: 100vh;
+  display: grid;
+  place-items: center;
+  padding: 24px 16px;
+  background: radial-gradient(120% 80% at 50% 0%, #fff3ee 0%, var(--bg) 58%);
+}
+.sm-auth__card {
+  width: 100%;
+  max-width: 392px;
+}
+.sm-auth__logo {
+  width: 60px;
+  height: 60px;
+  border-radius: 19px;
+  background: linear-gradient(135deg, var(--brand) 0%, #ff9166 100%);
+  color: #fff;
+  display: grid;
+  place-items: center;
+  font-size: 30px;
+  margin: 0 auto 14px;
+  box-shadow: 0 10px 26px rgba(255, 106, 61, 0.36);
+}
+.sm-auth__title {
+  text-align: center;
+  font-size: 23px;
+  font-weight: 720;
+  letter-spacing: -0.02em;
+}
+.sm-auth__sub {
+  text-align: center;
+  font-size: 13px;
+  color: var(--ink-3);
+  margin: 5px 0 20px;
+}
+.sm-auth__foot {
+  text-align: center;
+  font-size: 12px;
+  color: var(--ink-3);
+  margin-top: 16px;
+  line-height: 1.7;
+}
+
+/* ---------- 20. 弹层 ---------- */
+.sm-sheet {
+  position: fixed;
+  inset: 0;
+  z-index: 60;
+  display: flex;
+  align-items: flex-end;
+  justify-content: center;
+  background: rgba(18, 20, 26, 0.44);
